# Isolated install/run environment for Komet (runtimeverification/komet) —
# a Soroban fuzzing + symbolic-verification tool built on the K framework.
# Kept in a container because its installer is a curl-pipe-to-bash pulling Nix
# and the full K/KWasm toolchain — real unaudited install surface.
#
# x86_64 ONLY (the K toolchain ships x86_64). Build on the VPS, not an arm64 Mac.
#
# Build:  docker build -f Dockerfile.komet -t safu-komet .
# Run:    docker run --rm safu-komet komet test -C contracts/test-protection-pool
#
# ---------------------------------------------------------------------------
# REWRITTEN 2026-09-01, after reading https://kframework.org/install instead of
# guessing at it. Three container builds had failed on the Nix bootstrap; the
# script itself explains why none of that work was necessary:
#
#   line 21  refuses to run as root         -> the image must have a real user
#   line 24  if `nix` >=2.4 is ALREADY on PATH, the whole Determinate installer
#            is SKIPPED                     -> no systemd, no sudo, no env_keep
#   line 61  the actual work is just
#              nix profile install github:runtimeverification/kup#kup
#            then `kup install komet`
#   line 39  the k-framework binary caches are passed at nix-install time. On a
#            pre-existing nix they must be configured by hand, or komet BUILDS
#            FROM SOURCE instead of downloading.
#
# So: install nix in SINGLE-USER mode (`--no-daemon`). No daemon to start, no
# systemd to detect, no privilege escalation — which is what failures 5 and 6
# were both about. Base stays glibc Ubuntu because the prebuilt `stellar`
# binary is glibc; an Alpine-based nix image would break it.
#
# Earlier corrections retained:
#   * Rust + wasm32v1-none — `stellar contract build` COMPILES Rust.
#   * stellar CLI itself — Komet shells out to it (komet/kasmer.py:156).
#     Its absence is what made CI run 33481585123 report success while
#     verifying nothing.
#   * libdbus-1-3 / libudev1 — the prebuilt stellar binary links against them.
#   * kup lands in the NIX PROFILE, never ~/.kup/bin.
# ---------------------------------------------------------------------------

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates bash git xz-utils build-essential pkg-config \
    libdbus-1-3 libudev1 \
    && rm -rf /var/lib/apt/lists/*

# Stellar CLI. Asset resolved from the release API rather than hardcoded, so an
# upstream rename fails HERE at build time rather than silently at test time.
RUN set -eux; \
    URL="$(curl -fsSL https://api.github.com/repos/stellar/stellar-cli/releases/latest \
           | grep -oE '"browser_download_url": *"[^"]*x86_64-unknown-linux-gnu[^"]*\.tar\.gz"' \
           | head -1 | cut -d'"' -f4)"; \
    echo "stellar asset: $URL"; \
    curl -fsSL "$URL" -o /tmp/stellar.tar.gz; \
    tar -xzf /tmp/stellar.tar.gz -C /tmp; \
    install -m 0755 "$(find /tmp -maxdepth 3 -type f -name stellar | head -1)" \
            /usr/local/bin/stellar; \
    rm -f /tmp/stellar.tar.gz; \
    stellar --version

# A real non-root user (installer line 21), owning /nix so a single-user nix
# install needs no privilege escalation at all.
RUN useradd -m -s /bin/bash komet \
    && mkdir -m 0755 /nix \
    && chown komet:komet /nix

WORKDIR /work
COPY . /work
RUN chown -R komet:komet /work

USER komet
WORKDIR /home/komet
SHELL ["/bin/bash", "-c"]

# Rust, for `stellar contract build`. Pinned to match rust-toolchain.toml.
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --profile minimal --default-toolchain 1.96.0 --target wasm32v1-none
ENV PATH="/home/komet/.cargo/bin:${PATH}"

# Nix, SINGLE-USER. This is the change that matters.
RUN curl -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon
ENV PATH="/home/komet/.nix-profile/bin:${PATH}"

# The k-framework binary caches, copied from the K installer's own --extra-conf
# (lines 39-40 and 62-63). Without these, `kup install komet` compiles the K
# framework from source — hours, and it will exhaust this box.
RUN mkdir -p /home/komet/.config/nix \
    && printf '%s\n' \
      'experimental-features = nix-command flakes' \
      'substituters = https://cache.nixos.org https://k-framework.cachix.org' \
      'trusted-public-keys = cache.nixos.org-1:6NCHdD59X431o0gWypbMrAURkbJ16ZPMQFGspcDShjY= k-framework.cachix.org-1:jeyMXB2h28gpNRjuVkehg+zLj62ma1RnyyopA/20yFE= k-framework-binary.cachix.org-1:pJedQ8iG19BW3v/DMMmiRVtwRBGO3fyMv2Ws0OpBADs=' \
      > /home/komet/.config/nix/nix.conf

# kup then komet — the two commands the K installer actually runs once nix is
# present, called directly so the script's nix-bootstrap branch is bypassed.
RUN set -eux; \
    . /home/komet/.nix-profile/etc/profile.d/nix.sh; \
    GC_DONT_GC=1 nix profile install github:runtimeverification/kup#kup; \
    kup install komet

# Fail the BUILD if the toolchain is incomplete, rather than discovering it
# mid-run and reporting "nothing verified". Every binary Komet needs, run.
RUN set -eux; \
    . /home/komet/.nix-profile/etc/profile.d/nix.sh; \
    command -v stellar; stellar --version; \
    command -v cargo;   cargo --version; \
    rustup target list --installed | grep -qx wasm32v1-none; \
    command -v komet;   komet --help > /dev/null; \
    echo "TOOLCHAIN COMPLETE"

WORKDIR /work
CMD ["bash"]
