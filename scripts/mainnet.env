# Mainnet defaults for scripts/atomic_pool_vault_deploy.sh — T3 D1/Step 2.
#
# Usage:
#   export POOL_CONTRACT_ID=C...        # from the D1 deploy, the only value not fixed here
#   source scripts/mainnet.env
#   ./scripts/atomic_pool_vault_deploy.sh
#
# Every address below is VERIFIED, not remembered. Provenance is in
# outputs/2026-09-10_task-plan-safu-t3-mainnet-submission.md, "Verified value / How it was verified".
# Do not edit an address here without re-verifying it live the same way.
#
# This file is in scripts/. It is NOT part of the audited artifact: the frozen
# WASM 2cec7e74... is built from contracts/ only, so nothing here can move it.

# --- network -----------------------------------------------------------------
# MUST be safu-mainnet. The built-in `mainnet` alias has NO RPC configured
# ("Bring Your Own") and every stellar call fails with `error: Invalid URL`.
export NETWORK=safu-mainnet
export SOURCE_ACCOUNT=admin

# --- DeFindex (pinned, mainnet) ----------------------------------------------
export DEFINDEX_FACTORY_ID=CDKFHFJIET3A73A2YN4KV7NSV32S6YGQMUFH3DNJXLBWL4SKEGVRNFKI
export EXPECTED_FACTORY_ID=CDKFHFJIET3A73A2YN4KV7NSV32S6YGQMUFH3DNJXLBWL4SKEGVRNFKI
export EXPECTED_VAULT_WASM=ae3409a4090bc087b86b4e9b444d2b8017ccd97b90b069d44d005ab9f8e1468b

# --- assets ------------------------------------------------------------------
# XLM SAC: queried live — name/symbol "native", decimals 7, full SEP-41 surface.
export XLM_SAC=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# xlm_blend_autocompound_fixed_strategy, from DeFindex's published mainnet manifest.
export BLEND_STRATEGY=CDPWNUW7UMCSVO36VAJSQHQECISPJLCVPDASKHRC5SEROAAZDUQ5DG2Z
# Required positional arg, inert for us (single-asset vault, no swap path).
# Decoded from the live Peridot vault's instance storage, then verified by behaviour.
export SOROSWAP_ROUTER=CAG5LRYQ5JVEUI5TEID72EYOVX44TTUJT5BQR2J6J77FH65PCCFAJDDH

# --- vault roles (index order: 0 Emergency, 1 FeeReceiver, 2 Manager, 3 Rebalance) ---
export VAULT_EMERGENCY_ADDR=GDGTEULAYAGE5KZ6ULWQVXSBVYL6TSM5XMHK46ETVMM54JKEYGETWKV3
export VAULT_FEE_RECEIVER=GAIIAZPTZ4FDWW5M6V6TIY7H6HQEKX5MRI3QRVIONUHS4LHX4PIKZQKK
export VAULT_MANAGER_MULTISIG=GA3LAH55DRJCGQDXIDIEVFJXSXZRLOQLLAFJV2TRZYNAUHB64BOHQOIF
export VAULT_REBALANCE_ADDR=GA7QEEX7JISFG6EFP6YUNNGYXC2JXC6T3TFJJJPWCI3LZDL2WNG7NZTO

# --- vault construction ------------------------------------------------------
# 0 IS VALID and is the intended value — STRIDE Elevation.3 gate, and it matches
# the T2 testnet vault (get_fees() == [0, 2000]). The earlier "0 traps on mainnet"
# finding was a CONFOUNDED TEST: the fee was varied while the name stayed 21 chars,
# which traps at any fee. Re-tested one variable at a time by mainnet simulation
# 2026-09-10: with a name <= 20 chars, fee 0/1/2/100 all succeed.
export VAULT_FEE=0
# HARD LIMIT 20 CHARS. 21+ makes the vault constructor panic with
# UnreachableCodeReached and the factory reports nothing useful. "SAFU Protection
# Vault" was 21 and is what actually broke the first run.
export VAULT_NAME="SAFU Protection"
export VAULT_SYMBOL=SAFUXLM

# --- pool wiring -------------------------------------------------------------
export DEPLOY_BPS=500                    # 5%, well under MAX_DEPLOY_BPS=8000
export FIRST_DEPOSIT_AMOUNT=150000000    # 15 XLM in stroops = 5% of the 300 XLM staked

# --- guards ------------------------------------------------------------------
_here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

# The Manager role is permanent at vault construction — there is no set_manager.
# Refuse to arm the run while it is still a single key.
_mgr_signers=$(curl -s "https://horizon.stellar.org/accounts/${VAULT_MANAGER_MULTISIG}" \
  | python3 -c 'import sys,json;d=json.load(sys.stdin);print(len(d.get("signers",[])),d.get("thresholds",{}).get("med_threshold","?"))' 2>/dev/null)
if [ "${_mgr_signers%% *}" = "1" ]; then
  echo "REFUSING TO ARM: VAULT_MANAGER_MULTISIG ${VAULT_MANAGER_MULTISIG} has 1 signer." >&2
  echo "  Manager is PERMANENT at vault construction. Build the 2-of-3 first." >&2
  echo "  (signers med_threshold): ${_mgr_signers}" >&2
  return 1 2>/dev/null || exit 1
fi

# is_mainnet() in the script matches the alias by NAME. If safu-mainnet is not in
# that list, the factory pin and the vault-WASM pin SILENTLY SKIP on a real
# mainnet run. Fail loudly rather than deploy unpinned.
if ! grep -q 'safu-mainnet' "${_here}/atomic_pool_vault_deploy.sh"; then
  echo "REFUSING TO ARM: atomic_pool_vault_deploy.sh's is_mainnet() does not recognise" >&2
  echo "  NETWORK=safu-mainnet, so the factory pin and vault-WASM pin would skip silently." >&2
  echo "  Fix is_mainnet() before running against real funds." >&2
  return 1 2>/dev/null || exit 1
fi

unset _here _mgr_signers
echo "mainnet.env loaded. POOL_CONTRACT_ID=${POOL_CONTRACT_ID:-<UNSET — export it from the D1 deploy>}"
